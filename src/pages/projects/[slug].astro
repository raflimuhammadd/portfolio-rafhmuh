---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/site/Header.astro';
import Footer from '../../components/site/Footer.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import SectionAccordion from '../../components/ui/SectionAccordion.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { SECTION_CONFIG, parseSection, parseOutcomes } from '../../utils/parseMarkdownSections';
import type { ParsedSection, SectionConfig, OutcomeItem } from '../../utils/parseMarkdownSections';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project: CollectionEntry<'projects'>) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const { Content } = await render(project);

const images = project.data.images.length > 0 ? project.data.images : [project.data.image];

const parsedSections = SECTION_CONFIG.map(config => {
  const parsed = parseSection(config.heading, project.body);
  return {
    config,
    parsed
  };
});

interface RenderedSection {
  config: SectionConfig;
  parsed: ParsedSection | null;
  html: string;
}

const renderTextSection = (parsed: ParsedSection | null): string => {
  if (!parsed) return '<p class="text-neo-muted">Section not available</p>';
  if (!parsed.content) return '<p class="text-neo-muted">No content</p>';
  
  return `<p class="font-bold leading-relaxed text-lg">${parsed.content}</p>`;
};

const renderBulletSection = (parsed: ParsedSection | null): string => {
  if (!parsed || !parsed.hasBullets) {
    return '<p class="text-neo-muted">No items</p>';
  }
  
  const bulletHtml = parsed.bullets
    .map(bullet => `<li class="mb-2 leading-relaxed">${bullet}</li>`)
    .join('');
  
  return `<ul class="list-inside list-disc font-bold">${bulletHtml}</ul>`;
};

const renderOutcomesSection = (parsed: ParsedSection | null): OutcomeItem[] => {
  if (!parsed || !parsed.hasBullets) return [];
  return parseOutcomes(parsed.bullets);
};

const renderTextWithBulletsSection = (parsed: ParsedSection | null): string => {
  if (!parsed) return '<p class="text-neo-muted">Section not available</p>';
  
  let html = '';
  
  // Render intro if exists
  if (parsed.intro) {
    html += `<p class="font-black text-xl text-neo-accent leading-relaxed mb-4">${parsed.intro}</p>`;
  }
  
  // Render bullets if exist
  if (parsed.hasBullets) {
    const bulletHtml = parsed.bullets
      .map(bullet => `<li class="mb-2 leading-relaxed pl-2">${bullet}</li>`)
      .join('');
    html += `<ul class="list-outside list-disc font-bold space-y-1">${bulletHtml}</ul>`;
  }
  
  return html;
};

const renderSection = (section: RenderedSection): string => {
  switch(section.config.type) {
    case 'text':
      return renderTextSection(section.parsed);
    case 'text-with-bullets':
      return renderTextWithBulletsSection(section.parsed);
    case 'bullets':
      return renderBulletSection(section.parsed);
    case 'outcomes':
      return '';
    default:
      return '';
  }
};

---

<BaseLayout title={`${project.data.title} | Rafli Muhammad`} description={project.data.description}>
  <Header />
  
  <main class="min-h-screen bg-neo-bg">
    <div class="container mx-auto max-w-7xl px-4 md:px-6 py-12">
      <!-- Breadcrumb -->
      <div class="mb-6 flex flex-wrap items-center gap-2 text-sm font-bold uppercase tracking-wide">
        <a href="/" class="hover:underline">Home</a>
        <span>→</span>
        <a href="/#projects" class="hover:underline">Projects</a>
        <span>→</span>
        <span class="text-neo-accent">{project.data.title}</span>
      </div>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
        <!-- Main Content (8 columns on desktop) -->
        <div class="lg:col-span-8">
          <!-- Hero Title -->
          <h1 class="mb-4 font-black text-4xl uppercase leading-none md:text-6xl lg:text-7xl">
            {project.data.title}
          </h1>
          <p class="mb-8 font-bold text-xl leading-relaxed text-neo-black">
            {project.data.description}
          </p>

          <!-- Image Gallery - Thumbnails Grid -->
          <div class="mb-12 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-2">
            {images.map((img: string, idx: number) => (
              <button
                onclick={`openModal(${idx})`}
                class="group relative aspect-video w-full overflow-hidden rounded-lg border-4 border-neo-black bg-neo-white shadow-neo-md transition-all duration-200 hover:-translate-y-1 hover:shadow-neo-xl focus:outline-none focus:ring-4 focus:ring-neo-accent/30"
              >
                <img
                  src={img}
                  alt={`${project.data.title} - Image ${idx + 1}`}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                  loading={idx === 0 ? 'eager' : 'lazy'}
                />
                <div class="absolute inset-0 bg-neo-black/20 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
                <span class="absolute bottom-2 right-2 rounded bg-neo-black/80 px-2 py-1 text-xs font-black text-neo-white uppercase shadow-neo-sm">
                  View
                </span>
              </button>
            ))}
          </div>

          <!-- Accordion Sections -->
           <div class="space-y-4">
            {parsedSections.map(section => {
              if (section.config.type === 'outcomes') {
                const outcomes = renderOutcomesSection(section.parsed);
                return (
                  <SectionAccordion title={section.config.title} defaultOpen={section.config.defaultOpen}>
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                      {outcomes.map((item, idx) => (
                        item.isStat ? (
                          <div class="flex flex-col gap-2 border-4 border-neo-black bg-neo-white p-6 shadow-neo-md">
                            <span class="font-black text-5xl text-neo-accent">{item.value}</span>
                            <span class="font-bold uppercase text-sm leading-snug">{item.label}</span>
                          </div>
                        ) : (
                          <div class="border-4 border-neo-black bg-neo-white p-6 shadow-neo-md">
                            <p class="font-bold leading-relaxed">{item.text}</p>
                          </div>
                        )
                      ))}
                    </div>
                  </SectionAccordion>
                );
              }
              
              return (
                <SectionAccordion title={section.config.title} defaultOpen={section.config.defaultOpen}>
                  {section.config.type === 'text' && (
                    <div class="prose max-w-none space-y-4">
                      <Fragment set:html={renderTextSection(section.parsed)} />
                    </div>
                  )}

                  {section.config.type === 'text-with-bullets' && (
                    <Fragment set:html={renderTextWithBulletsSection(section.parsed)} />
                  )}

                  {section.config.type === 'bullets' && (
                    <Fragment set:html={renderBulletSection(section.parsed)} />
                  )}
                </SectionAccordion>
              );
            })}
          </div>

          <!-- Navigation Buttons -->
          <div class="mt-8 flex flex-wrap gap-4">
            {project.data.links.github && (
              <Button href={project.data.links.github} variant="outline" target="_blank">
                View on GitHub
              </Button>
            )}
            {project.data.links.demo && (
              <Button href={project.data.links.demo} variant="primary" target="_blank">
                Live Demo
              </Button>
            )}
            <Button href="/#projects" variant="secondary">
              ← Back to Projects
            </Button>
          </div>
        </div>

        <!-- Sidebar (4 columns on desktop) -->
        <div class="lg:col-span-4">
          <div class="sticky top-24 space-y-6">
            <!-- Project Info Card -->
            <div class="border-4 border-neo-black bg-neo-white p-6 shadow-neo-lg">
              <h3 class="mb-4 font-black text-lg uppercase">Project Info</h3>
              
              <div class="space-y-4">
                <div>
                  <p class="mb-2 font-bold uppercase tracking-widest text-neo-muted">Category</p>
                  <Badge variant={
                    project.data.category === 'web' ? 'accent' :
                    project.data.category === 'cloud' ? 'secondary' :
                    project.data.category === 'api' ? 'muted' : 'accent'
                  }>
                    {project.data.category.toUpperCase()}
                  </Badge>
                </div>
                
                <div>
                  <p class="mb-2 font-bold uppercase tracking-widest text-neo-muted">Year</p>
                  <p class="font-black text-2xl uppercase">{project.data.year}</p>
                </div>
                
                {project.data.featured && (
                  <div>
                    <p class="mb-2 font-bold uppercase tracking-widest text-neo-muted">Status</p>
                    <Badge variant="black" rotate>Featured</Badge>
                  </div>
                )}
              </div>
            </div>

            <!-- Tech Stack Card -->
            <div class="border-4 border-neo-black bg-neo-white p-6 shadow-neo-lg">
              <h3 class="mb-4 font-black text-lg uppercase">Tech Stack</h3>
              <div class="flex flex-wrap gap-2">
                {project.data.techStack.map((tech: string) => (
                  <span
                    class="border-2 border-neo-black bg-neo-bg px-3 py-1 text-xs font-black uppercase"
                  >
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <!-- Links Card -->
            <div class="border-4 border-neo-black bg-neo-white p-6 shadow-neo-lg">
              <h3 class="mb-4 font-black text-lg uppercase">Links</h3>
              <div class="space-y-3">
                {project.data.links.github && (
                  <Button href={project.data.links.github} variant="outline" class="w-full" target="_blank">
                    GitHub
                  </Button>
                )}
                {project.data.links.demo && (
                  <Button href={project.data.links.demo} variant="primary" class="w-full" target="_blank">
                    Live Demo
                  </Button>
                )}
              </div>
            </div>

            <!-- Mobile Back Button (only visible on mobile) -->
            <div class="lg:hidden">
              <Button href="/#projects" variant="secondary" class="w-full">
                ← Back to Projects
              </Button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Image Gallery Modal -->
    <div id="imageModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-neo-black/90 backdrop-blur-sm">
      <div class="relative flex h-full w-full items-center justify-center p-4 md:p-8">
        <button
          id="modalClose"
          class="absolute right-4 top-4 z-50 border-4 border-neo-black bg-neo-white px-4 py-2 font-black uppercase shadow-neo-md hover:bg-neo-accent hover:text-neo-white"
          aria-label="Close modal"
        >
          ✕
        </button>

        <button
          id="modalPrev"
          class="absolute left-4 z-40 hidden md:block border-4 border-neo-black bg-neo-white px-6 py-4 font-black uppercase shadow-neo-lg hover:bg-neo-accent hover:text-neo-white"
          aria-label="Previous image"
        >
          ←
        </button>

        <div class="relative max-h-[90vh] max-w-[90vw] overflow-hidden rounded-lg border-8 border-neo-black bg-neo-white">
          <img
            id="modalImage"
            src=""
            alt="Project image"
            class="h-auto max-h-[90vh] w-auto max-w-[90vw] object-contain"
          />
        </div>

        <button
          id="modalNext"
          class="absolute right-4 z-40 hidden md:block border-4 border-neo-black bg-neo-white px-6 py-4 font-black uppercase shadow-neo-lg hover:bg-neo-accent hover:text-neo-white"
          aria-label="Next image"
        >
          →
        </button>
      </div>

      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 rounded-full border-4 border-neo-black bg-neo-white/95 px-6 py-3 shadow-neo-md">
        <span id="modalCounter" class="font-black uppercase tracking-widest text-neo-black">1 / 1</span>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script define:vars={{ images }}>
  let currentImageIndex = 0;

  const modal = document.getElementById('imageModal');
  const modalImage = document.getElementById('modalImage');
  const modalCounter = document.getElementById('modalCounter');
  const modalClose = document.getElementById('modalClose');
  const modalPrev = document.getElementById('modalPrev');
  const modalNext = document.getElementById('modalNext');

  function openModal(index) {
    currentImageIndex = index;
    updateModal();
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.add('hidden');
    document.body.style.overflow = '';
  }

  function updateModal() {
    modalImage.src = images[currentImageIndex];
    modalCounter.textContent = `${currentImageIndex + 1} / ${images.length}`;
  }

  function nextImage() {
    currentImageIndex = (currentImageIndex + 1) % images.length;
    updateModal();
  }

  function prevImage() {
    currentImageIndex = (currentImageIndex - 1 + images.length) % images.length;
    updateModal();
  }

  modalClose.addEventListener('click', closeModal);
  modalPrev.addEventListener('click', prevImage);
  modalNext.addEventListener('click', nextImage);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (modal.classList.contains('hidden')) return;
    if (e.key === 'ArrowRight') nextImage();
    if (e.key === 'ArrowLeft') prevImage();
    if (e.key === 'Escape') closeModal();
  });

  window.openModal = openModal;
</script>

<style>
  .prose {
    @apply max-w-none;
  }
  
  .prose p {
    @apply font-bold leading-relaxed text-lg mb-4;
  }
  
  .prose ul {
    @apply list-inside list-disc font-bold mb-4;
  }
  
  .prose li {
    @apply mb-2;
  }
  
  .prose strong {
    @apply font-black text-neo-accent;
  }
</style>
