---
import { socials } from '../../data/socials';
import { siteData } from '../../data/site';

const currentYear = new Date().getFullYear();
---

<footer class="border-t-8 border-neo-black bg-neo-secondary">
  <div class="mx-auto px-6 md:px-12 lg:px-16 xl:px-20 py-12 md:py-16 max-w-[1600px]">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
      <!-- Brand -->
      <div>
        <h3 class="font-black text-2xl uppercase mb-4">{siteData.name}</h3>
        <p class="font-bold text-sm">{siteData.tagline}</p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-black text-lg uppercase mb-4 border-b-4 border-neo-black inline-block pb-1">Quick Links</h4>
        <ul class="space-y-2">
          <li><a href="#about" class="font-bold text-sm hover:underline hover:underline-offset-4">About</a></li>
          <li><a href="#projects" class="font-bold text-sm hover:underline hover:underline-offset-4">Projects</a></li>
          <li><a href="#blog" class="font-bold text-sm hover:underline hover:underline-offset-4">Blog</a></li>
          <li><a href="#contact" class="font-bold text-sm hover:underline hover:underline-offset-4">Contact</a></li>
        </ul>
      </div>

      <!-- Social Links -->
      <div>
        <h4 class="font-black text-lg uppercase mb-4 border-b-4 border-neo-black inline-block pb-1">Connect</h4>
        <div class="flex flex-wrap gap-3">
          {socials.map((social) => (
            <a 
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="border-4 border-neo-black bg-neo-white p-3 shadow-neo-sm hover:shadow-neo-md hover:-translate-y-1 transition-all"
              aria-label={social.name}
            >
              <span class="font-black text-xs uppercase">{social.icon}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t-4 border-neo-black">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="font-bold text-sm">© {currentYear} {siteData.name}. All rights reserved.</p>
        <p class="font-bold text-sm">Built with Astro</p>
      </div>
    </div>
  </div>
</footer>
