---
import { SUGGESTED_QUESTIONS } from '../lib/ai/prompts';
import Button from './ui/Button.astro';

interface Props {
  disabled?: boolean;
}

const { disabled = false } = Astro.props;
---

<div class="chat-input-container">
  <!-- Suggested Questions -->
  <div class="suggestions">
    {SUGGESTED_QUESTIONS.slice(0, 3).map(question => (
      <button 
        class="suggestion-chip"
        data-suggestion={question}
        disabled={disabled}
      >
        {question}
      </button>
    ))}
  </div>

  <!-- Input Field -->
  <div class="input-wrapper">
    <input
      id="chat-input"
      type="text"
      placeholder="Ask about Rafli's portfolio..."
      disabled={disabled}
    />
    <Button
      variant="primary"
      size="sm"
      type="button"
    >
      Send
    </Button>
  </div>
</div>

<style>
  .chat-input-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border-top: 3px solid var(--color-neo-black);
  }

  .suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .suggestion-chip {
    padding: 0.625rem 1.25rem;
    font-size: 0.85rem;
    background: var(--color-neo-secondary);
    border: 2px solid var(--color-neo-black);
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.2s;
    font-weight: 600;
  }

  .suggestion-chip:hover:not(:disabled) {
    background: var(--color-neo-accent);
    transform: translateY(-2px);
    box-shadow: 2px 2px 0px 0px var(--color-neo-black);
  }

  .suggestion-chip:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .input-wrapper {
    display: flex;
    gap: 0.75rem;
  }

  #chat-input {
    flex: 1;
    padding: 1rem 1.25rem;
    font-size: 1rem;
    border: 3px solid var(--color-neo-black);
    background: var(--color-neo-white);
    font-family: 'Space Grotesk', sans-serif;
  }

  #chat-input:focus {
    outline: none;
    box-shadow: 4px 4px 0px 0px var(--color-neo-black);
  }

  #chat-input:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (max-width: 640px) {
    .chat-input-container {
      padding: 1rem;
      gap: 0.75rem;
    }

    .suggestion-chip {
      padding: 0.5rem 1rem;
      font-size: 0.8rem;
    }

    #chat-input {
      padding: 0.875rem 1rem;
      font-size: 0.95rem;
    }

    .input-wrapper {
      gap: 0.5rem;
    }
  }
</style>
