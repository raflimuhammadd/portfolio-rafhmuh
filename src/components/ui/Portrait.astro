---
interface Props {
  src: string;
  alt: string;
}
const { src, alt } = Astro.props;
---

<div class="relative group w-[400px] md:w-[440px] grayscale hover:grayscale-0
contrast-125 transition-all duration-300 ease-linear">
  <div class="absolute inset-0 bg-black border-4 border-neo-black translate-x-2 translate-y-2 z-0"></div>
  <div class="absolute inset-0 border-2 border-neo-black opacity-0 group-hover:opacity-100 group-hover:translate-x-4 group-hover:translate-y-4 transition-all duration-200 ease-linear z-1"></div>
  <div class="relative border-4 border-neo-black bg-neo-white overflow-hidden transition-all duration-200 ease-linear group-hover:-translate-x-2 group-hover:-translate-y-2 z-2">
    <div class="flex items-center gap-2 px-4 py-3 bg-neo-accent border-b-4 border-neo-black">
      <div class="w-3 h-3 rounded-full bg-neo-black"></div>
      <div class="w-3 h-3 rounded-full bg-neo-black"></div>
      <div class="w-3 h-3 rounded-full bg-neo-black"></div>
    </div>
    <div class="relative h-[420px] md:h-[460px] w-full overflow-hidden bg-neo-secondary">
      <img
        src={src}
        alt={alt}
        class="absolute inset-0 w-full h-full object-cover"
      />
    </div>
  </div>

  <div class="absolute -bottom-5 -left-5 z-10 bg-neo-accent border-4 border-neo-black w-14 h-14 flex items-center justify-center -rotate-6 shadow-[4px_4px_0px_0px_#000]">
    <span class="font-mono text-lg font-black text-white">&lt;/&gt;</span>
  </div>
</div>