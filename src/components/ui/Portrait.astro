---
interface Props {
  src: string;
  alt: string;
}
const { src, alt } = Astro.props;
---

<div class="relative group w-[380px] md:w-[420px]">
  <div class="absolute inset-0 -rotate-3 border-4 border-neo-black bg-neo-white opacity-50 group-hover:translate-x-8 group-hover:translate-y-8 transition-transform duration-300 ease-linear delay-0"></div>
  
  <div class="absolute inset-0 -rotate-3 border-4 border-neo-black bg-neo-white opacity-30 group-hover:translate-x-16 group-hover:translate-y-16 transition-transform duration-300 ease-linear delay-75"></div>
  
  <div class="absolute inset-0 -rotate-3 border-4 border-neo-black bg-neo-white opacity-10 group-hover:translate-x-24 group-hover:translate-y-24 transition-transform duration-300 ease-linear delay-150"></div>

  <div class="relative border-4 border-neo-black bg-neo-white overflow-hidden -rotate-3 transition-all duration-200 ease-linear group-hover:rotate-0 group-hover:-translate-y-2 group-hover:-translate-x-2 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)]">

    <div class="flex items-center gap-2 px-4 py-3 bg-[#FF6B6B] border-b-4 border-neo-black">
      <div class="w-3 h-3 rounded-full bg-neo-black"></div>
      <div class="w-3 h-3 rounded-full bg-neo-black"></div>
      <div class="w-3 h-3 rounded-full bg-neo-black"></div>
    </div>

    <div class="relative h-[400px] md:h-[440px] w-full overflow-hidden">
      <img
        src={src}
        alt={alt}
        class="absolute inset-0 w-full h-full object-cover grayscale contrast-125 transition-all duration-200 ease-linear group-hover:grayscale-0"
      />
    </div>
  </div>

  <div class="absolute -bottom-5 -left-5 z-10 bg-[#FF6B6B] border-4 border-neo-black w-14 h-14 flex items-center justify-center -rotate-6 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
    <span class="font-mono text-lg font-black text-white">&lt;/&gt;</span>
  </div>
</div>
