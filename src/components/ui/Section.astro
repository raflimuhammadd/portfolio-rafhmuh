---
interface Props {
  id?: string;
  bgColor?: string;
  pattern?: 'dots' | 'grid' | 'none';
  class?: string;
  contentWidth?: 'default' | 'wide' | 'full';
  padding?: 'default' | 'reduced' | 'none';
  verticalPadding?: 'default' | 'reduced' | 'none';
}

const { 
  id,
  bgColor = 'bg-neo-bg',
  pattern = 'none',
  class: className = '',
  contentWidth = 'default',
  padding = 'default',
  verticalPadding = 'default'
} = Astro.props;

const patterns = {
  dots: 'bg-[radial-gradient(rgba(0,0,0,0.12)_1.5px,transparent_1.5px)] bg-[size:20px_20px]',
  grid: 'bg-[linear-gradient(to_right,rgba(0,0,0,0.1)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,0,0,0.1)_1px,transparent_1px)] bg-[size:40px_40px]',
  none: '',
};

const widthClasses = {
  default: 'max-w-[1600px]',
  wide: 'max-w-[1800px]',
  full: 'max-w-none',
};

const paddingClasses = {
  default: 'px-6 md:px-12 lg:px-16 xl:px-20',
  reduced: 'px-6 md:px-12 lg:px-16',
  none: '',
};

const verticalPaddingClasses = {
  default: 'py-16 md:py-24 lg:py-32',
  reduced: 'py-12 md:py-16',
  none: '',
};
---

<section id={id} class={`relative ${verticalPaddingClasses[verticalPadding]} ${bgColor} ${patterns[pattern]} ${className}`}>
  <div class={`mx-auto ${paddingClasses[padding]} ${widthClasses[contentWidth]}`}>
    <slot />
  </div>
</section>
