---
interface Props {
  images: string[];
}

const { images } = Astro.props;
---

<div
  id="image-gallery-modal"
  class="fixed inset-0 z-50 flex items-center justify-center bg-neo-black/90 backdrop-blur-sm transition-opacity duration-300 opacity-0 pointer-events-none"
  data-gallery="modal"
>
  <div id="gallery-backdrop" class="absolute inset-0"></div>
  
  <div class="relative flex h-full w-full items-center justify-center p-4 md:p-8">
    <button
      id="gallery-close-btn"
      class="absolute right-4 top-4 z-50 border-4 border-neo-black bg-neo-white px-4 py-2 font-black uppercase shadow-neo-md hover:bg-neo-accent hover:text-neo-white focus:outline-none focus:ring-4 focus:ring-neo-accent/30"
      aria-label="Close modal"
    >
      ✕
    </button>

    <button
      id="gallery-prev-btn"
      class="absolute left-2 md:left-4 z-40 border-4 border-neo-black bg-neo-white/90 md:bg-neo-white px-4 md:px-6 py-3 md:py-4 font-black text-xl md:text-2xl shadow-neo-lg hover:bg-neo-accent hover:text-neo-white focus:outline-none focus:ring-4 focus:ring-neo-accent/30 min-w-[44px] min-h-[44px]"
      aria-label="Previous image"
    >
      ←
    </button>

    <div id="gallery-image-container" class="relative max-h-[90vh] max-w-[90vw] overflow-hidden rounded-lg border-8 border-neo-black bg-neo-white shadow-neo-2xl">
      <img
        id="gallery-image"
        src={images[0]}
        alt="Project image 1"
        class="h-auto max-h-[90vh] w-auto max-w-[90vw] object-contain"
      />
    </div>

    <button
      id="gallery-next-btn"
      class="absolute right-2 md:right-4 z-40 border-4 border-neo-black bg-neo-white/90 md:bg-neo-white px-4 md:px-6 py-3 md:py-4 font-black text-xl md:text-2xl shadow-neo-lg hover:bg-neo-accent hover:text-neo-white focus:outline-none focus:ring-4 focus:ring-neo-accent/30 min-w-[44px] min-h-[44px]"
      aria-label="Next image"
    >
      →
    </button>
  </div>

  <div class="absolute bottom-4 md:bottom-8 left-1/2 -translate-x-1/2 rounded-full border-4 border-neo-black bg-neo-white/95 px-4 md:px-6 py-2 md:py-3 shadow-neo-md z-50">
    <span id="gallery-counter" class="font-black uppercase tracking-widest text-neo-black text-sm md:text-base">
      1 / {images.length}
    </span>
  </div>
</div>

<style>
  #image-gallery-modal.modal-open {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script is:inline define:vars={{ images }}>
  let currentIndex = 0;
  let touchStartX = 0;
  let touchEndX = 0;

  const modal = document.getElementById('image-gallery-modal');
  const imageEl = document.getElementById('gallery-image');
  const counterEl = document.getElementById('gallery-counter');
  const closeBtn = document.getElementById('gallery-close-btn');
  const prevBtn = document.getElementById('gallery-prev-btn');
  const nextBtn = document.getElementById('gallery-next-btn');
  const backdrop = document.getElementById('gallery-backdrop');
  const imageContainer = document.getElementById('gallery-image-container');

  const updateImage = () => {
    if (imageEl && counterEl) {
      imageEl.src = images[currentIndex];
      imageEl.alt = `Project image ${currentIndex + 1}`;
      counterEl.textContent = `${currentIndex + 1} / ${images.length}`;
    }
  };

  const nextImage = () => {
    currentIndex = (currentIndex + 1) % images.length;
    updateImage();
  };

  const prevImage = () => {
    currentIndex = (currentIndex - 1 + images.length) % images.length;
    updateImage();
  };

  const closeModal = () => {
    if (modal) {
      modal.classList.remove('modal-open');
      document.body.style.overflow = '';
    }
  };

  const openModal = (index) => {
    currentIndex = index;
    if (modal) {
      modal.classList.add('modal-open');
      document.body.style.overflow = 'hidden';
      updateImage();
    }
  };

  const handleKeyDown = (e) => {
    if (!modal?.classList.contains('modal-open')) return;
    if (e.key === 'ArrowRight') nextImage();
    if (e.key === 'ArrowLeft') prevImage();
    if (e.key === 'Escape') closeModal();
  };

  const handleTouchStart = (e) => {
    touchStartX = e.changedTouches[0].screenX;
  };

  const handleTouchEnd = (e) => {
    touchEndX = e.changedTouches[0].screenX;
    handleSwipe();
  };

  const handleSwipe = () => {
    const distance = touchStartX - touchEndX;
    const minSwipeDistance = 50;

    if (Math.abs(distance) > minSwipeDistance) {
      if (distance > 0) {
        nextImage();
      } else {
        prevImage();
      }
    }
  };

  closeBtn?.addEventListener('click', closeModal);
  prevBtn?.addEventListener('click', prevImage);
  nextBtn?.addEventListener('click', nextImage);
  backdrop?.addEventListener('click', (e) => {
    if (e.target === backdrop) closeModal();
  });
  imageContainer?.addEventListener('touchstart', handleTouchStart);
  imageContainer?.addEventListener('touchend', handleTouchEnd);
  document.addEventListener('keydown', handleKeyDown);

  window.openGalleryModal = openModal;
</script>
