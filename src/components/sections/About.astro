---
import Section from '../ui/Section.astro';
import Badge from '../ui/Badge.astro';
import Portrait from '../ui/Portrait.astro';
---

<Section id="about" bgColor="bg-neo-white" pattern="grid" contentWidth="default">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    <!-- Left: Content -->
    <div class="space-y-6">
      <div class="space-y-2">
        <Badge variant="secondary">About Me</Badge>
        <h2 class="font-black text-5xl md:text-6xl lg:text-7xl uppercase leading-tight">
          Muhammad Rafli <span class="text-neo-accent">Pratama</span>
        </h2>
      </div>

      <div class="space-y-4 text-lg md:text-xl font-bold leading-relaxed">
        <p>
          Full Stack engineer exploring cloud architecture with JavaScript, Express, AWS. I'm detail-oriented about code quality, collaborative with teams, and ambitious about building systems that actually work.
        </p>
      </div>

      <!-- CV & GitHub Buttons -->
      <div class="pt-6 flex flex-wrap gap-4">
        <a href="/downloads/Muhammad_Rafli_Pratama_CV.pdf" 
          download="Muhammad_Rafli_Pratama_CV.pdf" class="inline-flex items-center gap-2 px-6 py-3 border-4 
          border-neo-black bg-neo-white font-black text-sm uppercase tracking-wide hover:bg-neo-secondary 
          hover:shadow-neo-md transition-all">
          Download CV
        </a>
        <a href="https://github.com/raflimuhammadd" target="_blank" rel="noopener noreferrer" 
          class="inline-flex items-center gap-2 px-6 py-3 border-4 border-neo-black bg-neo-white 
          font-black text-sm uppercase tracking-wide hover:bg-neo-secondary hover:shadow-neo-md transition-all">
          View My Work
        </a>
      </div>

      <div class="space-y-3 pt-4">
        <p class="font-black text-sm uppercase tracking-wide text-neo-muted">Key Expertise:</p>
        <div class="flex flex-wrap gap-2">
          {['Full-Stack Development', 'Cloud Architecture', 'DevOps', 'Scalability'].map((skill) => (
            <Badge variant="accent">{skill}</Badge>
          ))}
        </div>
      </div>
    </div>

    <!-- Right: Portrait -->
    <div class="hidden lg:flex items-center justify-center">
      <Portrait 
        src="/images/rafli-photo.jpg"
        alt="Muhammad Rafli Pratama"
      />
    </div>
  </div>
</Section>
