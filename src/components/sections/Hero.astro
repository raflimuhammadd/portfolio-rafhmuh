---
import { siteData } from '../../data/site';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
---

<Section bgColor="bg-neo-bg" pattern="dots" class="min-h-screen flex items-center relative overflow-hidden">
  <!-- Decorative Elements -->
  <div class="absolute top-20 right-10 w-32 h-32 border-8 border-neo-black bg-neo-muted rotate-12 -z-0 hidden lg:block"></div>
  <div class="absolute bottom-32 left-10 w-24 h-24 border-8 border-neo-black bg-neo-secondary -rotate-6 -z-0 hidden lg:block"></div>
  
  <div class="relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: Text Content -->
      <div class="space-y-6 md:space-y-8">
        <!-- Badge -->
        <div class="flex gap-3 flex-wrap">
          <Badge variant="accent">Fresh Graduate</Badge>
          <Badge variant="secondary" rotate>Available for Hire</Badge>
        </div>

        <!-- Name with Text Stroke Effect -->
        <h1 class="font-black text-6xl md:text-7xl lg:text-8xl xl:text-9xl uppercase leading-none tracking-tighter">
          <span class="block text-stroke">{siteData.name.split(' ')[0]}</span>
          <span class="block -mt-2 md:-mt-4">{siteData.name.split(' ')[1]}</span>
        </h1>

        <!-- Title -->
        <div class="border-4 border-neo-black bg-neo-accent p-4 md:p-6 shadow-neo-lg inline-block -rotate-1">
          <h2 class="font-black text-xl md:text-2xl lg:text-3xl uppercase leading-tight">
            {siteData.title}
          </h2>
        </div>

        <!-- Tagline -->
        <p class="font-bold text-lg md:text-xl lg:text-2xl max-w-xl">
          {siteData.tagline}
        </p>

        <!-- Description -->
        <p class="font-medium text-base md:text-lg max-w-xl leading-relaxed">
          {siteData.description}
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4">
          <Button variant="primary" size="lg" href="#projects">
            View Projects
          </Button>
          <Button variant="outline" size="lg" href="#contact">
            Get In Touch
          </Button>
        </div>
      </div>

      <!-- Right: Visual Chaos -->
      <div class="relative hidden lg:flex items-center justify-center">
        <div class="relative w-full max-w-md">
          <!-- Large Number Background -->
          <div class="absolute inset-0 flex items-center justify-center opacity-10">
            <span class="font-black text-[20rem] leading-none">2026</span>
          </div>

          <!-- Stacked Elements -->
          <div class="relative space-y-6">
            <!-- Card 1 -->
            <div class="border-4 border-neo-black bg-neo-secondary p-6 shadow-neo-xl rotate-3">
              <p class="font-black text-2xl uppercase">Full Stack</p>
              <p class="font-bold text-sm mt-2">React • Node.js • PostgreSQL</p>
            </div>

            <!-- Card 2 -->
            <div class="border-4 border-neo-black bg-neo-muted p-6 shadow-neo-lg -rotate-2">
              <p class="font-black text-2xl uppercase">Cloud Infrastructure</p>
              <p class="font-bold text-sm mt-2">AWS • Docker • Terraform</p>
            </div>

            <!-- Card 3 -->
            <div class="border-4 border-neo-black bg-neo-accent p-6 shadow-neo-md rotate-1">
              <p class="font-black text-2xl uppercase">Machine Learning</p>
              <p class="font-bold text-sm mt-2">Object Detection • Computer Vision • LLM</p>
            </div>
          </div>

          <!-- Floating Badge -->
          <div class="absolute -top-8 -right-8 animate-bounce">
            <Badge variant="black" class="text-sm px-4 py-2 shadow-neo-md">⭐ NEW</Badge>
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 hidden md:block">
      <a href="#about" class="flex flex-col items-center gap-2 font-bold text-sm uppercase tracking-wide hover:text-neo-accent transition-colors">
        <span>Scroll Down</span>
        <svg class="w-6 h-6 animate-bounce" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>
  </div>
</Section>
