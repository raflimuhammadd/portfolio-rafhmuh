---
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.filter(p => p.data.featured).slice(0, 3);
---

<Section id="projects" bgColor="bg-neo-bg" pattern="dots">
  <div class="space-y-12">
    <!-- Header -->
    <div class="space-y-4">
      <Badge variant="accent">Featured Work</Badge>
      <h2 class="font-black text-5xl md:text-6xl lg:text-7xl uppercase leading-tight">
        Latest Projects
      </h2>
      <p class="font-bold text-xl max-w-2xl">
        Showcasing my best work across full-stack development, cloud infrastructure, and API design
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {featuredProjects.map((project, index) => (
        <Card class={`flex flex-col h-full ${index === 1 ? 'lg:col-span-1 lg:row-span-2' : ''} ${['rotate-2', '-rotate-1', 'rotate-1'][index]}`}>
          <div class="flex-1 flex flex-col gap-4 p-6">
            <Badge variant={
              project.data.category === 'web' ? 'accent' :
              project.data.category === 'cloud' ? 'secondary' :
              'muted'
            }>
              {project.data.category}
            </Badge>

            <h3 class="font-black text-2xl md:text-3xl uppercase leading-tight">
              {project.data.title}
            </h3>

            <p class="font-bold text-base leading-relaxed flex-1">
              {project.data.description}
            </p>

            <div class="flex flex-wrap gap-2 pt-4 border-t-4 border-neo-black">
              {project.data.techStack.slice(0, 5).map((tech) => (
                <span class="bg-neo-bg border-2 border-neo-black px-3 py-1 text-xs font-bold uppercase">
                  {tech}
                </span>
              ))}
            </div>

            <Button href={`/projects/${project.data.slug}`} variant="outline" size="md" class="w-full mt-4">
              View Case Study →
            </Button>
          </div>
        </Card>
      ))}
    </div>

    <!-- View All Button -->
    <div class="text-center pt-8">
      <Button href="/projects" variant="primary" size="lg">
        View All Projects
      </Button>
    </div>
  </div>
</Section>
