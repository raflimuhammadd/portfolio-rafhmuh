---
import ChatInput from './ChatInput.astro';
---

<div id="chat-widget">
  <!-- Floating Button -->
  <button 
    id="chat-toggle" 
    class="chat-button"
    aria-label="Open chat"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
  </button>

  <!-- Chat Modal -->
  <div id="chat-modal" class="chat-modal hidden">
    <!-- Header -->
    <div class="chat-header">
      <h3>BrutAssistant</h3>
      <button id="close-chat" class="close-button" aria-label="Close chat">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Messages Container -->
    <div id="messages-container" class="messages-container">
      <div class="welcome-message">
        <p>Hey! 👋 I'm Rafli's portfolio assistant. Ask me anything about his skills, projects, or experience!</p>
      </div>
    </div>

    <!-- Input -->
    <ChatInput />
  </div>
</div>

<style>
  .chat-button {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 56px;
    height: 56px;
    border-radius: 9999px;
    background: var(--color-neo-accent);
    border: 4px solid var(--color-neo-black);
    box-shadow: 8px 8px 0px 0px var(--color-neo-black);
    cursor: pointer;
    transition: all 0.2s;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chat-button:hover {
    transform: translate(-2px, -2px);
    box-shadow: 10px 10px 0px 0px var(--color-neo-black);
  }

  .chat-modal {
    position: fixed;
    bottom: 6rem;
    right: 2rem;
    width: 600px;
    max-height: 70vh;
    background: var(--color-neo-white);
    border: 4px solid var(--color-neo-black);
    box-shadow: 12px 12px 0px 0px var(--color-neo-black);
    z-index: 998;
    display: flex;
    flex-direction: column;
    animation: slideInUp 0.3s ease-out;
  }

  .chat-modal.hidden {
    display: none;
  }

  .chat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 3px solid var(--color-neo-black);
    background: var(--color-neo-secondary);
  }

  .chat-header h3 {
    font-size: 1rem;
    font-weight: 800;
    margin: 0;
  }

  .close-button {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .close-button:hover {
    color: var(--color-neo-accent);
  }

  .messages-container {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-height: calc(70vh - 220px);
  }

  .welcome-message {
    background: var(--color-neo-bg);
    padding: 1.5rem;
    border-radius: 0.5rem;
    border: 2px solid var(--color-neo-black);
    font-size: 1rem;
    line-height: 1.6;
    text-align: center;
  }

  .message {
    max-width: 85%;
    padding: 1rem 1.25rem;
    border-radius: 0.5rem;
    border: 3px solid var(--color-neo-black);
    box-shadow: 4px 4px 0px 0px var(--color-neo-black);
    animation: slideIn 0.3s ease-out;
  }

  .message.user {
    margin-left: auto;
    text-align: right;
    background: var(--color-neo-accent);
  }

  .message.assistant {
    margin-right: auto;
    text-align: left;
    background: var(--color-neo-white);
  }

  .message-content {
    font-size: 1rem;
    line-height: 1.6;
    word-wrap: break-word;
  }

  .message-timestamp {
    font-size: 0.7rem;
    color: #666;
    margin-top: 0.25rem;
    opacity: 0.7;
  }

  @keyframes slideInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1024px) {
    .chat-modal {
      width: 90vw;
      max-width: 600px;
      bottom: 5rem;
      right: 1rem;
    }

    .messages-container {
      max-height: calc(70vh - 220px);
    }
  }

  @media (max-width: 640px) {
    .chat-modal {
      width: 100%;
      height: 100%;
      bottom: 0;
      right: 0;
      max-height: 100vh;
      box-shadow: none;
      border: none;
    }

    .messages-container {
      max-height: calc(100vh - 200px);
      padding: 1rem;
    }

    .chat-header {
      padding: 1rem 1.5rem;
    }

    .message {
      max-width: 90%;
      padding: 0.875rem 1rem;
    }

    .message-content {
      font-size: 0.95rem;
    }

    .chat-button {
      bottom: 1.5rem;
      right: 1.5rem;
      width: 48px;
      height: 48px;
    }
  }
</style>

<script>
  import { saveMessages, loadMessages } from '../utils/chat-storage';
  import type { Message } from '../lib/types/chat';

  let isOpen = false;
  let messages: Message[] = [];
  let isLoading = false;

  // Load history on mount
  document.addEventListener('DOMContentLoaded', () => {
    messages = loadMessages();
    renderMessages();
    attachEventListeners();
  });

  function attachEventListeners() {
    // Toggle button
    const toggleBtn = document.getElementById('chat-toggle');
    toggleBtn?.addEventListener('click', toggleChat);

    // Close button
    const closeBtn = document.getElementById('close-chat');
    closeBtn?.addEventListener('click', toggleChat);

    // Send button
    const sendBtn = document.querySelector('.chat-input-container button[type="button"]');
    sendBtn?.addEventListener('click', handleSendMessage);

    // Enter key
    const input = document.getElementById('chat-input') as HTMLInputElement;
    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !isLoading) {
        handleSendMessage();
      }
    });

    // Suggestion chips
    const chips = document.querySelectorAll('.suggestion-chip');
    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const suggestion = chip.getAttribute('data-suggestion');
        if (suggestion && input) {
          input.value = suggestion;
          input.focus();
        }
      });
    });
  }

  function toggleChat() {
    isOpen = !isOpen;
    const modal = document.getElementById('chat-modal');
    modal?.classList.toggle('hidden', !isOpen);
  }

  async function handleSendMessage() {
    const input = document.getElementById('chat-input') as HTMLInputElement;
    const message = input.value.trim();
    
    if (!message || isLoading) return;

    // Create user message
    const userMessage: Message = {
      id: crypto.randomUUID(),
      role: 'user',
      content: message,
      timestamp: Date.now()
    };

    messages.push(userMessage);
    input.value = '';
    renderMessages();
    saveMessages(messages);

    // Show loading state
    isLoading = true;
    setInputDisabled(true);
    renderLoadingIndicator();

    try {
      // Call API
      const response = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message,
          history: messages.slice(-10) // Send last 10 messages for context
        })
      });

      const data = await response.json();

      if (data.success && data.message) {
        messages.push(data.message);
        saveMessages(messages);
      } else {
        throw new Error(data.error || 'Failed to get response');
      }
    } catch (error) {
      console.error('Chat error:', error);
      const errorMessage: Message = {
        id: crypto.randomUUID(),
        role: 'assistant',
        content: 'Sorry, I encountered an error. Please try again!',
        timestamp: Date.now()
      };
      messages.push(errorMessage);
      saveMessages(messages);
    } finally {
      isLoading = false;
      setInputDisabled(false);
      removeLoadingIndicator();
      renderMessages();
    }
  }

  function renderMessages() {
    const container = document.getElementById('messages-container');
    if (!container) return;

    // Keep welcome message
    container.innerHTML = `
      <div class="welcome-message">
        <p>Hey! 👋 I'm Rafli's portfolio assistant. Ask me anything about his skills, projects, or experience!</p>
      </div>
    `;

    // Render all messages
    messages.forEach(msg => {
      const messageEl = document.createElement('div');
      messageEl.className = `message ${msg.role}`;
      messageEl.innerHTML = `
        <div class="message-content">${msg.content}</div>
        <div class="message-timestamp">${new Date(msg.timestamp).toLocaleTimeString()}</div>
      `;
      container.appendChild(messageEl);
    });

    // Scroll to bottom
    container.scrollTop = container.scrollHeight;
  }

  function renderLoadingIndicator() {
    const container = document.getElementById('messages-container');
    if (!container) return;

    const loadingEl = document.createElement('div');
    loadingEl.id = 'loading-indicator';
    loadingEl.className = 'message assistant';
    loadingEl.innerHTML = '<div class="message-content">Thinking...</div>';
    container.appendChild(loadingEl);
    container.scrollTop = container.scrollHeight;
  }

  function removeLoadingIndicator() {
    const loadingEl = document.getElementById('loading-indicator');
    loadingEl?.remove();
  }

  function setInputDisabled(disabled: boolean) {
    const input = document.getElementById('chat-input') as HTMLInputElement;
    const sendBtn = document.querySelector('.chat-input-container button[type="button"]') as HTMLButtonElement;
    const chips = document.querySelectorAll('.suggestion-chip') as NodeListOf<HTMLButtonElement>;
    
    if (input) input.disabled = disabled;
    if (sendBtn) sendBtn.disabled = disabled;
    chips.forEach(chip => chip.disabled = disabled);
  }
</script>
